# Copy this file to .env and fill in the values. Never commit .env.

# --- Required ---
PORT=4000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=prescripto
# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Comma-separated frontend URLs allowed to call the API (leave empty for local dev)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Cloudinary (doctor/patient images) ---
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=

# --- Email (optional; emails are skipped if any of these is missing) ---
# Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=465, EMAIL_SECURE=true, EMAIL_PASS = a Gmail App Password
EMAIL_HOST=
EMAIL_PORT=
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Haram Medical Complex (HMC) <you@example.com>"

# --- WhatsApp (optional; WhatsApp is skipped if not configured) ---
# Provider: kapso | meta | twilio  (empty = Twilio if its keys are set)
WHATSAPP_PROVIDER=kapso
# Hospital using Qclinics: shown in WhatsApp messages and emails (email, address, website are optional)
HOSPITAL_NAME="Haram Medical Complex (HMC)"
HOSPITAL_PHONE=+920000000000
HOSPITAL_EMAIL=
HOSPITAL_ADDRESS=
HOSPITAL_WEBSITE=

# Kapso (official WhatsApp Cloud API via a Meta partner) - https://kapso.com
KAPSO_API_KEY=
# Secret shown when you create the webhook in Kapso; webhook URL:
# https://your-api.onrender.com/api/whatsapp/kapso-webhook  (event: whatsapp.message.received)
KAPSO_WEBHOOK_SECRET=

# Meta Cloud API directly (instead of Kapso): WHATSAPP_PROVIDER=meta
META_ACCESS_TOKEN=

# Used by Kapso and Meta. Templates are submitted with: npm run templates:sync
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Language of WhatsApp messages for patients who haven't chosen one: ur (Urdu) or en.
# Each patient's language is set on their record (Add/Edit Patient, booking form).
# Until the Urdu templates are approved by Meta, Urdu patients get English automatically.
WHATSAPP_DEFAULT_LANGUAGE=ur
# Meta language code of the English templates (only change if yours were made as e.g. en_US)
WHATSAPP_TEMPLATE_LANGUAGE=en

# Automatic reminders (hospital time). Empty / 0 turns one off.
# On an always-on server they're checked every 5 minutes. On Vercel a daily cron
# (vercel.json, 19:00 Pakistan time) calls /api/cron/reminders with this secret:
# set CRON_SECRET in Vercel to any long random string. Free Vercel plans allow one
# run a day, so only the evening-before reminder is sent there.
CRON_SECRET=
REMINDERS_ENABLED=true
REMINDER_DAY_BEFORE_AT=19:00
REMINDER_MINUTES_BEFORE=60
# Hospital time zone as minutes ahead of UTC (Pakistan = 300)
HOSPITAL_UTC_OFFSET_MINUTES=300

# Follow-up visits booked by a doctor are free within this many days of the
# original visit (0 = always charge the doctor's normal fee)
FOLLOW_UP_FREE_DAYS=0

# --- Live queue (walk-in tokens) ---
# Patient website URL (no trailing slash): token WhatsApp messages and slip QR codes
# link to <PUBLIC_SITE_URL>/queue/t/<id>, and the waiting-room screen is <PUBLIC_SITE_URL>/queue
PUBLIC_SITE_URL=https://your-hospital-site.com
# Minutes per patient used for wait estimates until today's real visits give an average
QUEUE_DEFAULT_MINUTES=10
# Send "your turn is near" when this many patients are ahead (0 = off)
QUEUE_NOTIFY_AHEAD=3
# false turns off all queue WhatsApp messages (each one is a paid Meta message)
QUEUE_WHATSAPP=true

# --- Lab ---
# false hides the lab module (lab logins, test requests, reports)
LAB_ENABLED=true
# Where report files are stored: cloudinary (private files, default when Cloudinary is set up)
# or local (this server's disk; only for development or a server with a permanent disk:
# Render/Vercel wipe the disk on restart). Google Drive can be added as another option later.
REPORT_STORAGE=cloudinary
# Folder for REPORT_STORAGE=local
REPORT_LOCAL_DIR=uploads/lab-reports

# Number that receives the admin "Send Test WhatsApp Message" button
TEST_WHATSAPP_NUMBER=

# --- WhatsApp via Twilio (when WHATSAPP_PROVIDER=twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox number is +14155238886
TWILIO_WHATSAPP_NUMBER=
# Exact webhook URL set in the Twilio console, e.g. https://your-api.onrender.com/api/whatsapp/webhook
TWILIO_WEBHOOK_URL=
