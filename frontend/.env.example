# Backend API URL (no trailing slash)
VITE_BACKEND_URL=http://localhost:4000

# Hospital using Qclinics (shown across the site)
VITE_HOSPITAL_NAME="Haram Medical Complex (HMC)"
# Optional, shown on the queue screens
VITE_HOSPITAL_NAME_URDU=
VITE_HOSPITAL_PHONE=+920000000000
VITE_HOSPITAL_EMAIL=info@example.com
VITE_HOSPITAL_ADDRESS=Hospital address, City
# Optional: opening hours shown on the site (English, then Urdu)
VITE_HOSPITAL_HOURS=Mon–Sat, 9 am – 9 pm
VITE_HOSPITAL_HOURS_URDU=پیر تا ہفتہ، صبح 9 سے رات 9 بجے تک
# Optional: Google Maps link for "Open in Google Maps" (otherwise the address is searched)
VITE_HOSPITAL_MAP_URL=

# Qclinics contact for demo requests on the marketing site
# (defaults: +923338082908 and hanzladev376@gmail.com)
VITE_SALES_PHONE=+923338082908
VITE_SALES_EMAIL=hanzladev376@gmail.com
# Staff app address, for the "Staff sign in" link (e.g. https://staff.example.pk)
VITE_STAFF_APP_URL=
# Public address of the website (no trailing slash), for canonical links, hreflang,
# sitemap.xml and WhatsApp/Facebook link previews. Leave empty until there is a domain;
# on Vercel the production .vercel.app address is used automatically.
VITE_SITE_URL=
